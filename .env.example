# ==============================================================================
# 模式一：极简仅发信配置（纯 SMTP，零 IMAP 负担）
# 若仅需外发邮件（通知、告警、报告等），仅需配置以下 5-6 项，无需配置 IMAP。
# ==============================================================================
MCP_SMTP_HOST=smtp.example.com
MCP_SMTP_PORT=465
MCP_SMTP_SECURE=true
MCP_SMTP_USER=user@example.com
MCP_SMTP_PASS=YOUR_SMTP_PASSWORD
MCP_SMTP_FROM="MCP Email Assistant <user@example.com>"

# ==============================================================================
# 模式二：全功能收发一体配置（追加 IMAP 参数）
# 若需使用邮件检索、正文提纯、会话回复、草稿审查与附件下载，请补充以下 IMAP 参数。
# ==============================================================================
MCP_IMAP_HOST=imap.example.com
MCP_IMAP_PORT=993
MCP_IMAP_SECURE=true
MCP_IMAP_USER=user@example.com
MCP_IMAP_PASS=YOUR_IMAP_PASSWORD

# ==============================================================================
# 多账户模式 (可选，配置后自动启用多画像路由并优先使用)
# ==============================================================================
# MCP_DEFAULT_ACCOUNT=work
# MCP_ACCOUNTS='{"personal":{"smtp":{"host":"smtp.qq.com","port":465,"secure":true,"user":"me@qq.com","pass":"YOUR_AUTH_CODE"},"imap":{"host":"imap.qq.com","port":993,"secure":true,"user":"me@qq.com","pass":"YOUR_AUTH_CODE"}}}'
# MCP_ACCOUNTS_FILE=/path/to/accounts.json

# ==============================================================================
# 附件沙箱与存储 (可选，未指定时默认使用系统隔离临时目录)
# ==============================================================================
# MCP_ATTACHMENT_DIR=/data/mcp-email-attachments

# ==============================================================================
# MCP 服务端传输模式配置 (stdio / sse)
# ==============================================================================
MCP_TRANSPORT=stdio
MCP_PORT=3000
MCP_LOG_LEVEL=info
